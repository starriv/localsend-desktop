# Generated by nsh (types, tsconfig, test runner); never committed.
.nsh/
target/

# Generated by the screenshot suites. Only the README montage is committed
# (docs/screenshots/overview.png, composed by scripts/montage-screenshots.py);
# the per-screen captures stay local. `.gitkeep` keeps the directory in a fresh
# checkout, because `app.screenshot(path)` does not create it.
/screenshots/*
!/screenshots/.gitkeep

# Device identity generated by a local run (never commit private keys)
/.localsend-desktop/
/.localsend-client/

# macOS Finder metadata
.DS_Store
**/.DS_Store
